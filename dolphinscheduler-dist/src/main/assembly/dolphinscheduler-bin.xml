<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.1.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.1.0 http://maven.apache.org/xsd/assembly-2.1.0.xsd">
    <id>bin</id>
    <formats>
        <format>tar.gz</format>
    </formats>
    <includeBaseDirectory>true</includeBaseDirectory>
    <baseDirectory>${project.build.finalName}-bin</baseDirectory>

    <fileSets>
        <fileSet>
            <directory>${basedir}/../dolphinscheduler-alert/dolphinscheduler-alert-server/target/alert-server</directory>
            <outputDirectory>alert-server</outputDirectory>
        </fileSet>

        <fileSet>
            <directory>${basedir}/../dolphinscheduler-api/target/api-server</directory>
            <outputDirectory>api-server</outputDirectory>
        </fileSet>

        <fileSet>
            <directory>${basedir}/../dolphinscheduler-master/target/master-server</directory>
            <outputDirectory>master-server</outputDirectory>
        </fileSet>

        <fileSet>
            <directory>${basedir}/../dolphinscheduler-worker/target/worker-server</directory>
            <outputDirectory>worker-server</outputDirectory>
        </fileSet>

        <!-- plugins: alert-plugins -->
        <fileSet>
            <directory>${basedir}/../dolphinscheduler-alert/dolphinscheduler-alert-plugins</directory>
            <includes>
                <include>dolphinscheduler-alert-http/target/dolphinscheduler-alert-http-*-shade.jar</include>
                <include>dolphinscheduler-alert-prometheus/target/dolphinscheduler-alert-prometheus-*-shade.jar</include>
            </includes>
            <outputDirectory>plugins/alert-plugins</outputDirectory>
        </fileSet>

        <!-- plugins: datasource-plugins -->
        <fileSet>
            <directory>${basedir}/../dolphinscheduler-datasource-plugin</directory>
            <includes>
                <include>dolphinscheduler-datasource-k8s/target/dolphinscheduler-datasource-k8s-*-shade.jar</include>
                <include>dolphinscheduler-datasource-mysql/target/dolphinscheduler-datasource-mysql-*-shade.jar</include>
                <include>dolphinscheduler-datasource-postgresql/target/dolphinscheduler-datasource-postgresql-*-shade.jar</include>
                <include>dolphinscheduler-datasource-ssh/target/dolphinscheduler-datasource-ssh-*-shade.jar</include>
                <include>dolphinscheduler-datasource-starrocks/target/dolphinscheduler-datasource-starrocks-*-shade.jar</include>
            </includes>
            <outputDirectory>plugins/datasource-plugins</outputDirectory>
        </fileSet>

        <!-- plugins: task-plugins -->
        <fileSet>
            <directory>${basedir}/../dolphinscheduler-task-plugin</directory>
            <includes>
                <include>dolphinscheduler-task-flink/target/dolphinscheduler-task-flink-*-shade.jar</include>
                <include>dolphinscheduler-task-flink-stream/target/dolphinscheduler-task-flink-stream-*-shade.jar</include>
                <include>dolphinscheduler-task-flink-sqlgateway/target/dolphinscheduler-task-flink-sqlgateway-*-shade.jar</include>
                <include>dolphinscheduler-task-http/target/dolphinscheduler-task-http-*-shade.jar</include>
                <include>dolphinscheduler-task-grpc/target/dolphinscheduler-task-grpc-*-shade.jar</include>
                <include>dolphinscheduler-task-java/target/dolphinscheduler-task-java-*-shade.jar</include>
                <include>dolphinscheduler-task-k8s/target/dolphinscheduler-task-k8s-*-shade.jar</include>
                <include>dolphinscheduler-task-linkis/target/dolphinscheduler-task-linkis-*-shade.jar</include>
                <include>dolphinscheduler-task-seatunnel/target/dolphinscheduler-task-seatunnel-*-shade.jar</include>
                <include>dolphinscheduler-task-shell/target/dolphinscheduler-task-shell-*-shade.jar</include>
                <include>dolphinscheduler-task-sql/target/dolphinscheduler-task-sql-*-shade.jar</include>
            </includes>
            <outputDirectory>plugins/task-plugins</outputDirectory>
        </fileSet>

        <!-- plugins: storage-plugins -->
        <fileSet>
            <directory>${basedir}/../dolphinscheduler-storage-plugin</directory>
            <includes>
                <include>dolphinscheduler-storage-s3/target/dolphinscheduler-storage-s3-*-shade.jar</include>
            </includes>
            <outputDirectory>plugins/storage-plugins</outputDirectory>
        </fileSet>
        <!-- plugins -->

        <fileSet>
            <directory>${basedir}/../dolphinscheduler-standalone-server/target/standalone-server</directory>
            <outputDirectory>standalone-server</outputDirectory>
        </fileSet>

        <fileSet>
            <directory>${basedir}/../dolphinscheduler-tools/target/tools</directory>
            <outputDirectory>tools</outputDirectory>
        </fileSet>

        <fileSet>
            <directory>${basedir}/../dolphinscheduler-dist/target/dolphinscheduler-dist-${project.version}</directory>
            <outputDirectory>.</outputDirectory>
        </fileSet>

        <fileSet>
            <directory>${basedir}/../dolphinscheduler-ui/dist</directory>
            <outputDirectory>./ui</outputDirectory>
        </fileSet>

        <fileSet>
            <directory>${basedir}/../script</directory>
            <outputDirectory>bin</outputDirectory>
            <fileMode>0755</fileMode>
            <directoryMode>0755</directoryMode>
        </fileSet>

        <fileSet>
            <directory>${basedir}/../config</directory>
            <outputDirectory>conf</outputDirectory>
        </fileSet>

        <fileSet>
            <directory>${basedir}/.././</directory>
            <includes>
                <include>mvnw</include>
                <include>mvnw.cmd</include>
            </includes>
            <fileMode>0755</fileMode>
            <outputDirectory>.</outputDirectory>
        </fileSet>

        <fileSet>
            <directory>${basedir}/../.mvn/</directory>
            <outputDirectory>.mvn</outputDirectory>
        </fileSet>

        <fileSet>
            <directory>${basedir}/release-docs</directory>
            <outputDirectory>.</outputDirectory>
        </fileSet>
    </fileSets>
</assembly>
